generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum InventoryTxnType {
  OPENING_STOCK
  PURCHASE
  SALE
  SALE_RETURN
  CUSTOMER_RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVATION
  RESERVATION_RELEASE
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

enum OrderSource {
  WHATSAPP
  AMAZON
  FLIPKART
  WEBSITE
  MANUAL
}

enum OrderStatus {
  NEW
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_RECEIVED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  COD
  RAZORPAY
  STRIPE
  BANK_TRANSFER
}

enum PaymentProviderKind {
  MOCK
  RAZORPAY
  STRIPE
}

enum StockCommitment {
  NONE
  RESERVED
  COMMITTED
  RELEASED
}

model Tenant {
  id             String       @id @default(uuid())
  name           String
  businessName   String
  slug           String       @unique
  logo           String?
  email          String
  mobile         String
  address        String?
  gstNumber      String?
  status         TenantStatus @default(TRIAL)
  trialStartDate DateTime?
  trialEndDate   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  users                User[]
  subscriptions        TenantSubscription[]
  features             TenantFeature[]
  auditLogs            AuditLog[]
  categories           Category[]
  brands               Brand[]
  products             Product[]
  productVariants      ProductVariant[]
  productMedia         ProductMedia[]
  warehouses           Warehouse[]
  inventoryTxns        InventoryTransaction[]
  stockBalances        StockBalance[]
  stockTransfers       StockTransfer[]
  stockTransferItems   StockTransferItem[]
  customers            Customer[]
  customerAddresses    CustomerAddress[]
  orders               Order[]
  orderItems           OrderItem[]
  payments             Payment[]
  suppliers            Supplier[]
  purchases            PurchaseOrder[]
  purchaseItems        PurchaseItem[]
  whatsappConnection   WhatsAppConnection?
  whatsappThreads      WhatsAppThread[]
  whatsappMessages     WhatsAppMessage[]
  marketplaceAccounts  MarketplaceAccount[]
  marketplaceListings  MarketplaceListing[]
  marketplaceOrders    MarketplaceOrder[]
  shipments            Shipment[]
  returnRequests       ReturnRequest[]
  customerAccounts     CustomerAccount[]
  carts                Cart[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  customerRefreshTokens CustomerRefreshToken[]

  @@index([status])
  @@index([email])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  email        String
  passwordHash String
  firstName    String
  lastName     String
  mobile       String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant               Tenant?                 @relation(fields: [tenantId], references: [id])
  userRoles            UserRole[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  inventoryTxns        InventoryTransaction[]  @relation("InventoryCreatedBy")
  stockTransfers       StockTransfer[]         @relation("TransferCreatedBy")
  orders               Order[]                 @relation("OrderCreatedBy")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([slug, tenantId])
  @@index([slug])
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  module    String
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceYearly  Decimal? @db.Decimal(12, 2)
  currency     String   @default("INR")
  featureKeys  String[] @default([])
  isActive     Boolean  @default(true)
  isCustom     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id           String             @id @default(uuid())
  tenantId     String
  planId       String
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([planId])
}

model TenantFeature {
  id         String  @id @default(uuid())
  tenantId   String
  featureKey String
  isEnabled  Boolean @default(false)
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Category {
  id        String       @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  image     String?
  status    RecordStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@index([tenantId, status])
}

model Brand {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id                 String        @id @default(uuid())
  tenantId           String
  name               String
  productCode        String?
  sku                String
  barcode            String?
  categoryId         String?
  brandId            String?
  description        String?
  purchasePrice      Decimal       @default(0) @db.Decimal(12, 2)
  sellingPrice       Decimal       @default(0) @db.Decimal(12, 2)
  mrp                Decimal       @default(0) @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  gstRate            Decimal       @default(0) @db.Decimal(5, 2)
  hsnCode            String?
  attributes         Json          @default("{}")
  status             ProductStatus @default(ACTIVE)
  allowNegativeStock Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand      Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  media      ProductMedia[]
  inventory  InventoryTransaction[]
  balances   StockBalance[]
  transferItems StockTransferItem[]
  orderItems OrderItem[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model ProductVariant {
  id                 String       @id @default(uuid())
  tenantId           String
  productId          String
  sku                String
  barcode            String?
  color              String?
  size               String?
  attributes         Json         @default("{}")
  purchasePrice      Decimal      @db.Decimal(12, 2)
  sellingPrice       Decimal      @db.Decimal(12, 2)
  mrp                Decimal      @default(0) @db.Decimal(12, 2)
  minimumStockLevel  Int          @default(0)
  status             RecordStatus @default(ACTIVE)
  isDefault          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     InventoryTransaction[]
  balances      StockBalance[]
  transferItems StockTransferItem[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  listings      MarketplaceListing[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, status])
}

model ProductMedia {
  id        String    @id @default(uuid())
  tenantId  String
  productId String
  url       String
  type      MediaType @default(IMAGE)
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
}

model Warehouse {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  status    RecordStatus @default(ACTIVE)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory       InventoryTransaction[]
  balances        StockBalance[]
  transfersFrom   StockTransfer[]        @relation("TransferFrom")
  transfersTo     StockTransfer[]        @relation("TransferTo")
  orders          Order[]
  purchases       PurchaseOrder[]
  shipments       Shipment[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model InventoryTransaction {
  id              String           @id @default(uuid())
  tenantId        String
  productId       String
  variantId       String
  warehouseId     String
  transactionType InventoryTxnType
  quantity        Int
  physicalDelta   Int
  reservedDelta   Int
  referenceType   String?
  referenceId     String?
  notes           String?
  createdById     String?
  createdAt       DateTime         @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy User?           @relation("InventoryCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, variantId, warehouseId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@index([tenantId, transactionType])
  @@index([referenceType, referenceId])
}

model StockBalance {
  id          String @id @default(uuid())
  tenantId    String
  productId   String
  variantId   String
  warehouseId String
  physicalQty Int    @default(0)
  reservedQty Int    @default(0)
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantId, warehouseId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
}

model StockTransfer {
  id               String              @id @default(uuid())
  tenantId         String
  transferNumber   String
  fromWarehouseId  String
  toWarehouseId    String
  status           StockTransferStatus @default(DRAFT)
  notes            String?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse          @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse          @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User?              @relation("TransferCreatedBy", fields: [createdById], references: [id])
  items         StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status])
}

model StockTransferItem {
  id         String @id @default(uuid())
  tenantId   String
  transferId String
  productId  String
  variantId  String
  quantity   Int

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId, transferId])
}

model Customer {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  mobile          String
  whatsappNumber  String?
  email           String?
  gender          Gender    @default(UNSPECIFIED)
  dateOfBirth     DateTime?
  totalOrders     Int       @default(0)
  totalPurchase   Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderDate   DateTime?
  notes           String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  account   CustomerAccount?
  cart      Cart?
  wishlist  WishlistItem[]
  returns   ReturnRequest[]

  @@unique([tenantId, mobile])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, status])
}

model CustomerAddress {
  id         String       @id @default(uuid())
  tenantId   String
  customerId String
  label      AddressLabel @default(HOME)
  name       String?
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String       @default("India")
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model Order {
  id              String          @id @default(uuid())
  tenantId        String
  orderNumber     String
  source          OrderSource     @default(MANUAL)
  customerId      String
  warehouseId     String
  status          OrderStatus     @default(NEW)
  stockState      StockCommitment @default(NONE)
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentMethod   PaymentMethod   @default(CASH)
  notes           String?
  shippingAddress Json?
  cancelledReason String?
  cancelledAt     DateTime?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  createdBy User?      @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  returns   ReturnRequest[]
  marketplaceOrder MarketplaceOrder?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentStatus])
}

model OrderItem {
  id            String  @id @default(uuid())
  tenantId      String
  orderId       String
  productId     String
  variantId     String
  sku           String
  productName   String
  variantLabel  String?
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  tax           Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}

model Payment {
  id                String              @id @default(uuid())
  tenantId          String
  orderId           String
  provider          PaymentProviderKind @default(MOCK)
  providerPaymentId String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  status            PaymentStatus       @default(PENDING)
  method            PaymentMethod
  idempotencyKey    String              @unique
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([providerPaymentId])
  @@index([status])
}

enum PurchaseStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MarketplacePlatform {
  AMAZON
  FLIPKART
}

enum MarketplaceAccountStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum ShippingProviderKind {
  MOCK
  SHIPROCKET
  DELHIVERY
  BLUEDART
  DTDC
}

enum ShipmentStatus {
  CREATED
  LABELLED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  mobile         String
  email          String?
  gstNumber      String?
  address        String?
  paymentBalance Decimal  @default(0) @db.Decimal(12, 2)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases PurchaseOrder[]

  @@unique([tenantId, mobile])
  @@index([tenantId, name])
}

model PurchaseOrder {
  id             String         @id @default(uuid())
  tenantId       String
  purchaseNumber String
  supplierId     String
  warehouseId    String
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  items     PurchaseItem[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, status])
}

model PurchaseItem {
  id              String  @id @default(uuid())
  tenantId        String
  purchaseId      String
  productId       String
  variantId       String
  quantityOrdered Int
  quantityReceived Int    @default(0)
  unitCost        Decimal @db.Decimal(12, 2)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase PurchaseOrder  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId, purchaseId])
}

model WhatsAppConnection {
  id                 String                     @id @default(uuid())
  tenantId           String                     @unique
  phoneNumber        String
  businessAccountId  String?
  accessTokenEnc     String?
  status             WhatsAppConnectionStatus   @default(DISCONNECTED)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WhatsAppThread {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  phone      String
  lastMessageAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastMessageAt])
}

model WhatsAppMessage {
  id        String           @id @default(uuid())
  tenantId  String
  threadId  String
  direction MessageDirection
  body      String
  template  String?
  createdAt DateTime         @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([tenantId, threadId])
}

model MarketplaceAccount {
  id             String                    @id @default(uuid())
  tenantId       String
  platform       MarketplacePlatform
  sellerId       String?
  credentialsEnc String?
  status         MarketplaceAccountStatus  @default(DISCONNECTED)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings MarketplaceListing[]
  orders   MarketplaceOrder[]

  @@unique([tenantId, platform])
}

model MarketplaceListing {
  id         String              @id @default(uuid())
  tenantId   String
  accountId  String
  variantId  String
  externalSku String
  createdAt  DateTime            @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  variant ProductVariant     @relation(fields: [variantId], references: [id])

  @@unique([tenantId, accountId, externalSku])
  @@index([tenantId, variantId])
}

model MarketplaceOrder {
  id              String              @id @default(uuid())
  tenantId        String
  accountId       String
  platform        MarketplacePlatform
  externalOrderId String
  orderId         String              @unique
  rawPayload      Json?
  createdAt       DateTime            @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform, externalOrderId])
}

model Shipment {
  id              String               @id @default(uuid())
  tenantId        String
  orderId         String
  warehouseId     String
  provider        ShippingProviderKind @default(MOCK)
  awb             String
  trackingUrl     String?
  status          ShipmentStatus       @default(CREATED)
  labelUrl        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, orderId])
  @@index([awb])
}

model ReturnRequest {
  id        String       @id @default(uuid())
  tenantId  String
  orderId   String
  customerId String
  reason    String
  status    ReturnStatus @default(REQUESTED)
  restock   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model CustomerAccount {
  id           String     @id @default(uuid())
  tenantId     String
  customerId   String     @unique
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokens CustomerRefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model CustomerRefreshToken {
  id        String    @id @default(uuid())
  accountId String
  tenantId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Cart {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String   @unique
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  tenantId  String
  cartId    String
  productId String
  variantId String
  quantity  Int

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([tenantId, cartId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  tenantId  String
  customerId String
  productId String
  variantId String
  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([customerId, variantId])
  @@index([tenantId, customerId])
}
